# Forever Jojo ♾️ — environment variables
# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Variables starting with NEXT_PUBLIC_ are sent to the browser — they are
# designed to be public. Everything else must stay secret.

# --- Site ---------------------------------------------------------------
# Your public address, used for share previews and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostgreSQL (required) ----------------------------------------------
# SECRET. Any PostgreSQL 13+ works: Neon, Railway, Vercel Postgres, Supabase's
# database, or PostgreSQL on your own computer. Hosted providers usually need
# ?sslmode=require at the end.
#   Hosted example: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/jojo?sslmode=require
#   Local example:  postgresql://postgres:your-password@localhost:5432/jojo
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/jojo
# Optional: connections per server instance (default 5).
# DATABASE_POOL_SIZE=5

# --- Cloudinary (photo + video storage and delivery) ---------------------
# Cloudinary console → Settings → API Keys (or the Dashboard).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# SECRET — server only. Used to sign uploads and delete files.
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
# Optional: the Cloudinary folder everything is stored under.
CLOUDINARY_FOLDER=forever-jojo

# --- Upload limits shown in the dashboard ---------------------------------
# Match these to your Cloudinary plan (Free: 10 MB images, 100 MB videos).
NEXT_PUBLIC_MAX_IMAGE_UPLOAD_MB=10
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=100

# --- Optional: sign in with Supabase Auth instead of the built-in sign-in ---
# Leave these out to use the built-in email + password sign-in (recommended).
# If set, the Supabase account's email must also be added with
#   insert into admin_users (email) values ('you@example.com');
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
